{
  "engine": "edge",
  "voice": "zh-CN-YunyangNeural",
  "total": 202.337,
  "scenes": [
    {
      "id": "intro",
      "start": 0.0,
      "duration": 11.302,
      "lines": [
        {
          "start": 0.7,
          "end": 4.223,
          "text": "同一个模型，换一套工作套件，表现可能差很多。"
        },
        {
          "start": 4.643,
          "end": 10.402,
          "text": "Harness² 研究的是：在没有标准答案的新任务上，怎样边做边改这套工作套件。"
        }
      ]
    },
    {
      "id": "harness",
      "start": 11.302,
      "duration": 14.286,
      "lines": [
        {
          "start": 0.7,
          "end": 8.812,
          "text": "Harness 是包在模型外面的整套工作环境：指令、手册、记忆、脚本、工具设置、子代理和检查钩子。"
        },
        {
          "start": 9.232,
          "end": 13.386,
          "text": "整个算法里，模型参数不变，被修改的只有这套 harness。"
        }
      ]
    },
    {
      "id": "reference",
      "start": 25.588,
      "duration": 22.025,
      "lines": [
        {
          "start": 0.7,
          "end": 6.702,
          "text": "来看论文里的一个任务：根据日程、人员、场地和预算，整理一组制片交付物。"
        },
        {
          "start": 7.122,
          "end": 11.15,
          "text": "第零步，用原始 harness 完整做一遍，留下参考轨迹。"
        },
        {
          "start": 11.57,
          "end": 16.78,
          "text": "轨迹暴露了两个问题：几份文件之间的数字没有核对，写完以后也没有复查。"
        },
        {
          "start": 17.2,
          "end": 21.125,
          "text": "注意，参考轨迹只说明它怎么做，不说明做得对不对。"
        }
      ]
    },
    {
      "id": "propose",
      "start": 47.613,
      "duration": 22.158,
      "lines": [
        {
          "start": 0.7,
          "end": 5.753,
          "text": "第一步，提出。两位编辑者从不同方向，各写一份候选 harness。"
        },
        {
          "start": 6.173,
          "end": 13.188,
          "text": "通用编辑者处理跨行业的做事习惯：先清点所有输入，结束前用脚本重新打开每份产出。"
        },
        {
          "start": 13.608,
          "end": 21.258,
          "text": "领域编辑者处理当前行业：加入预算核对手册，并提醒表格里的金额要先去掉符号和逗号再计算。"
        }
      ]
    },
    {
      "id": "probe",
      "start": 69.771,
      "duration": 17.196,
      "lines": [
        {
          "start": 0.7,
          "end": 7.151,
          "text": "第二步，试跑。每份候选都在同一任务、同一模型、同一环境里重新执行。"
        },
        {
          "start": 7.571,
          "end": 13.248,
          "text": "把候选轨迹和参考轨迹并排比较：原来的问题有没有消失，有没有带来新的问题。"
        },
        {
          "start": 13.668,
          "end": 16.296,
          "text": "这里判断的是行为变化，不是答案对错。"
        }
      ]
    },
    {
      "id": "compose",
      "start": 86.967,
      "duration": 19.689,
      "lines": [
        {
          "start": 0.7,
          "end": 6.466,
          "text": "第三步，组合。组合者阅读全部轨迹，只保留有行为对比支持的修改。"
        },
        {
          "start": 6.886,
          "end": 12.025,
          "text": "每一处采用都要对应一条具体观察；没有证据支持的修改，直接舍弃。"
        },
        {
          "start": 12.445,
          "end": 18.789,
          "text": "这一例中，四处修改都留了下来。新 harness 再运行，核对了数字，也补齐了备忘录。"
        }
      ]
    },
    {
      "id": "score",
      "start": 106.656,
      "duration": 22.576,
      "lines": [
        {
          "start": 0.7,
          "end": 6.008,
          "text": "整个改进过程中，编辑者、组合者和挑选者都看不到评分标准和分数。"
        },
        {
          "start": 6.428,
          "end": 12.473,
          "text": "论文只在事后用评分器衡量：这份产出从 43.1 分升到 77.8 分。"
        },
        {
          "start": 12.893,
          "end": 21.676,
          "text": "另一组实验里，较弱的 GLM-5 改进后从 64.2 升到 75.7，超过了较强模型用原 harness 的 72.4。"
        }
      ]
    },
    {
      "id": "budget",
      "start": 129.232,
      "duration": 19.243,
      "lines": [
        {
          "start": 0.7,
          "end": 5.49,
          "text": "预算更多时，可以并行写出 k 组候选，也可以顺序连续改 k 轮。"
        },
        {
          "start": 5.91,
          "end": 12.379,
          "text": "两种方式都会得到几份结果，由挑选者在不知道来源的情况下，对照任务要求选出一份。"
        },
        {
          "start": 12.799,
          "end": 18.343,
          "text": "什么时候停下？论文按预先设定的预算停止，而不是等到证明结果正确。"
        }
      ]
    },
    {
      "id": "library",
      "start": 148.475,
      "duration": 20.412,
      "lines": [
        {
          "start": 0.7,
          "end": 5.972,
          "text": "任务结束后，反思者回看整个改进记录，只提炼有试跑证据支持的经验。"
        },
        {
          "start": 6.392,
          "end": 11.31,
          "text": "经验库保存采用的 harness、可运行脚本、适用情形和支持证据。"
        },
        {
          "start": 11.73,
          "end": 19.512,
          "text": "下一项任务仍然从原始 harness 出发，只在提出和组合修改时查阅经验库，再用新的试跑确认是否有用。"
        }
      ]
    },
    {
      "id": "boundary",
      "start": 168.888,
      "duration": 18.979,
      "lines": [
        {
          "start": 0.7,
          "end": 3.164,
          "text": "但是，行为变化不等于结果正确。"
        },
        {
          "start": 3.584,
          "end": 12.124,
          "text": "一项代码任务里，五份结果事后得分是 95、85、85、80 和 55，挑选者却选了 55 分那份。"
        },
        {
          "start": 12.544,
          "end": 18.079,
          "text": "如果几份候选共享同一个错误假设，它们会犯同样的错，对比也照不出来。"
        }
      ]
    },
    {
      "id": "summary",
      "start": 187.866,
      "duration": 14.471,
      "lines": [
        {
          "start": 0.7,
          "end": 7.159,
          "text": "总结一下：任务内，用同条件试跑筛选修改；任务间，把有证据的经验交给下一项任务。"
        },
        {
          "start": 7.579,
          "end": 13.571,
          "text": "它让 harness 的改进有据可查，但真正的正确性，仍然需要独立验证和真实反馈。"
        }
      ]
    }
  ]
}
